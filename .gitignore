.venv/
venv/
env/


# Claude Code local settings
.claude/settings.local.json

# Streamlit logs
*.log

# 니케 정보 CSV (개인 데이터)
니케정보_*.csv

# 개인 메모
memo.txt

# blablalink 로그인 세션 (계정 접근권 = 절대 커밋 금지)
scraper/.session_cookie
# 육성 프로필 (개인 계정 육성 데이터 = 로컬 전용)
profiles/

# Playwright MCP 산출물 (브라우저 스냅샷·콘솔 로그)
.playwright-mcp/

# 딜량 보고서 작업 파일 (로컬 전용)
.report-work/

# 생성된 보고서 (로컬 전용)
reports/

# 웹앱 빌드 산출물 (web/src + build.py에서 언제든 다시 만든다)
web/dist/

# archive의 기존 로컬 산출물은 무시
archive/*

# 커밋 스킬
.agent/skills/commit/
.claude/skills/commit/

# 배포 스킬 (public 레포 절차·계정 정보가 담겨 로컬 전용)
.agent/skills/publish/
.claude/skills/publish/

# 웹앱 로드맵 (내부 결정 문서. dev에서는 추적되지만 배포 트리에는 넣지 않는다)
webapp-roadmap.md

# 이 파일 자신 (dev에서는 추적되지만 배포 트리에는 넣지 않는다)
.gitignore
